@page "{filter?}"
@model IgelPortal.Web.Pages.Hedgehogs.DetailsModel

@{
    ViewData["Title"] = SharedLocalizer["Details"];
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>@Localizer["Hedgehog"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2 mb-2">
            <label asp-for="Hedgehog.Name"></label>
        </dt>
        <dd class="col-sm-10 mb-2">
            @Model.Hedgehog.Name
        </dd>
        <dt class="col-sm-2">
            <label asp-for="Hedgehog.BiologicalSex"></label>
        </dt>
        <dd class="col-sm-10">
            @{
                ViewBag.DisplayText = true;
            }
            <partial name="_HedgehogGenderPartial" model="@Model.Hedgehog.BiologicalSex" />
        </dd>
        <dt class="col-sm-2 mb-2">
            <label asp-for="Hedgehog.HomeTerritory"></label>
        </dt>
        <dd class="col-sm-10 mb-2">
            @(Model.Hedgehog.HomeTerritory ?? SharedLocalizer["No territory"].Value)
        </dd>
        <dt class="col-sm-2 mb-2">
            <label asp-for="Hedgehog.CurrentTerritory"></label>
        </dt>
        <dd class="col-sm-10 mb-2">
            @(Model.Hedgehog.CurrentTerritory ?? SharedLocalizer["No territory"].Value) @(Model.Hedgehog.UsedService != null ? $" ({Model.Hedgehog.UsedService})" : "")
        </dd>
        <dt class="col-sm-2 mb-2">
            <label asp-for="Hedgehog.Community"></label>
        </dt>
        <dd class="col-sm-10 mb-2">
            @(Model.Hedgehog.Community ?? SharedLocalizer["No community"].Value)
        </dd>
        <dt class="col-sm-2 mb-2">
            <label asp-for="Hedgehog.ChangeDate"></label>
        </dt>
        <dd class="col-sm-10 mb-2">
            @Model.Hedgehog.ChangeDate
        </dd>
    </dl>
</div>
<div class="btn-group" role="group">
    <a class="btn btn-secondary" asp-page="./Edit" asp-route-id="@Model.Hedgehog.Id" asp-route-filter="@ViewBag.Filter"><i class="bi bi-pencil"></i><span class="d-none d-md-inline"> @SharedLocalizer["Edit"]</span></a>
    <a class="btn btn-info" asp-page="./Index" asp-route-filter="@ViewBag.Filter"><i class="bi bi-card-list"></i><span class="d-none d-md-inline"> @SharedLocalizer["Back to List"]</span></a>
</div>
