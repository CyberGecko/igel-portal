@page "{filter?}"
@model IgelPortal.Web.Pages.Hedgehogs.DetailsModel

@{
    ViewData["Title"] = Model.Hedgehog.Name;
}

<div class="page-heading">
    <div class="record-heading">
        <img src="~/images/hedgehog-avatar.webp" asp-append-version="true" width="56" height="56" alt="" />
        <h1>@Model.Hedgehog.Name</h1>
    </div>
</div>

<div class="portal-form">
    <dl class="row">
        <dt class="col-sm-2">
            <label asp-for="Hedgehog.BiologicalSex"></label>
        </dt>
        <dd class="col-sm-10">
            @SharedLocalizer[Model.Hedgehog.BiologicalSex.ToString()]
        </dd>
        <dt class="col-sm-2 mb-2">
            <label asp-for="Hedgehog.HomeTerritory"></label>
        </dt>
        <dd class="col-sm-10 mb-2">
            @(Model.Hedgehog.HomeTerritory ?? SharedLocalizer["No territory"].Value)
        </dd>
        <dt class="col-sm-2 mb-2">
            <label asp-for="Hedgehog.CurrentTerritory"></label>
        </dt>
        <dd class="col-sm-10 mb-2">
            @(Model.Hedgehog.CurrentTerritory ?? SharedLocalizer["No territory"].Value) @(Model.Hedgehog.UsedService != null ? $" ({Model.Hedgehog.UsedService})" : "")
        </dd>
        <dt class="col-sm-2 mb-2">
            <label asp-for="Hedgehog.Community"></label>
        </dt>
        <dd class="col-sm-10 mb-2">
            @(Model.Hedgehog.Community ?? SharedLocalizer["No community"].Value)
        </dd>
        <dt class="col-sm-2 mb-2">
            <label asp-for="Hedgehog.ChangeDate"></label>
        </dt>
        <dd class="col-sm-10 mb-2">
            @Model.Hedgehog.ChangeDate
        </dd>
    </dl>
</div>
<div class="portal-actions mt-3">
    @if (Model.CanReadCare)
    {
        <a class="btn btn-primary" asp-page="./Care" asp-route-id="@Model.Hedgehog.Id">@SharedLocalizer["Care journal"]</a>
    }
    @if (Model.CanRequestPlace)
    {
        <a class="btn btn-outline-primary" asp-page="./RequestService" asp-route-id="@Model.Hedgehog.CommunityId" asp-route-hedgehogId="@Model.Hedgehog.Id">@SharedLocalizer["Find a place"]</a>
    }
    @if (Model.Hedgehog.AttachedUser == User.Identity?.Name)
    {
        <a class="btn btn-outline-primary" asp-page="./Edit" asp-route-id="@Model.Hedgehog.Id" asp-route-filter="@ViewBag.Filter">@SharedLocalizer["Edit"]</a>
    }
    <a class="btn btn-outline-primary" asp-page="./Index" asp-route-filter="@ViewBag.Filter">@SharedLocalizer["Back to List"]</a>
</div>
