@page
@model IgelPortal.Web.Pages.Hedgehogs.ChangeAttachedUserModel
@{
    ViewData["Title"] = Localizer["Hedgehog"];
}

<h1>@ViewData["Title"]</h1>

<h4>@Localizer["Change Attached User"]</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input id="hedgehogId" name="hedgehogId" type="hidden" value="@ViewBag.HedgehogId" />
            <input id="communityId" name="communityId" type="hidden" value="@ViewBag.CommunityId" />
            <div class="row">
                <div class="form-group input-group mb-3">
                    <span class="control-label input-group-text">
                        @Localizer["Current attached user:"]
                    </span>
                    <input id="attachedUserDisplayName" type="text" disabled class="form-control" value="@ViewBag.CurrentAttachedUser" />
                </div>
                <div class="form-group input-group mb-3">
                    <span class="control-label input-group-text">
                        @Localizer["New attached user:"]
                    </span>
                    <select id="newAttachedUserName" name="newAttachedUserName" class="form-control" asp-items="Model.AttachableUser">
                        <option value="" disabled selected>@Localizer["Select an attached user"]</option>
                    </select>
                </div>
            </div>
            <div class="form-group mb-3">
                <button type="submit" class="btn btn-success">@SharedLocalizer["Save"]</button>
            </div>
        </form>
    </div>
</div>