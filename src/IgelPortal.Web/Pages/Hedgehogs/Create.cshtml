@page "{filter?}"
@model IgelPortal.Web.Pages.Hedgehogs.CreateModel
@{
    ViewData["Title"] = SharedLocalizer["Add hedgehog"];
}

<div class="page-heading">
    <h1>@ViewData["Title"]</h1>
</div>
<form method="post" asp-route-filter="@ViewBag.Filter" class="portal-form">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    @Html.EditorFor(model => model.Hedgehog, "HedgehogFields")
    <div class="portal-actions">
        <button class="btn btn-primary" type="submit">@SharedLocalizer["Save"]</button>
        <a class="btn btn-outline-primary" asp-page="./Index" asp-route-filter="@ViewBag.Filter">@SharedLocalizer["Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
