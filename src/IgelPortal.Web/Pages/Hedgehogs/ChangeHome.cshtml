@page
@model IgelPortal.Web.Pages.Hedgehogs.ChangeHomeModel
@{
    ViewData["Title"] = Localizer["Hedgehog"];
}

<h1>@ViewData["Title"]</h1>

<h4>@Localizer["Change Home Territory"]</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input id="hedgehogId" name="hedgehogId" type="hidden" value="@ViewBag.HedgehogId" />
            <input id="communityId" name="communityId" type="hidden" value="@ViewBag.CommunityId" />
            <div class="row">
                <div class="form-group input-group mb-3">
                    <span class="control-label input-group-text">
                        @Localizer["Current home territory:"]
                    </span>
                    <input id="currentHomeTerritory" type="text" disabled class="form-control" value="@ViewBag.CurrentHomeTerritory" />
                </div>
                <div class="form-group input-group mb-3">
                    <span class="control-label input-group-text">
                        @Localizer["New home territory:"]
                    </span>
                    <select id="newHomeTerritoryId" name="newHomeTerritoryId" class="form-control" asp-items="@Model.Territories">
                        <option value="" disabled selected>@SharedLocalizer["Select a territory"]</option>
                    </select>
                </div>
            </div>
            <div class="form-group mb-3">
                <button type="submit" class="btn btn-success">@SharedLocalizer["Save"]</button>
            </div>
        </form>
    </div>
</div>