@page
@model IgelPortal.Web.Pages.Hedgehogs.MoveTerritoryModel
@{
    ViewData["Title"] = Localizer["Move Territory"];
}

<div class="page-heading"><h1>@ViewData["Title"]</h1></div>
<p>@Localizer["Current territory:"] @(ViewBag.CurrentTerritory ?? SharedLocalizer["No territory"].Value)</p>

<form method="post" class="portal-form mb-4" id="move-territory-form"
      data-services-url="@Url.Page("./MoveTerritory", "LoadTerritoryServices", new { id = ViewBag.CommunityId })"
      data-loading="@Localizer["Checking available services…"]"
      data-empty="@Localizer["No free services in this territory."]"
      data-error="@Localizer["Could not load services. Select the territory again."]">
    <input name="hedgehogId" type="hidden" value="@ViewBag.HedgehogId" />
    <input name="communityId" type="hidden" value="@ViewBag.CommunityId" />
    <div class="mb-3">
        <label for="newTerritoryId" class="form-label">@Localizer["New territory:"]</label>
        <select id="newTerritoryId" name="newTerritoryId" class="form-select" asp-items="Model.Territories" required>
            <option value="">@SharedLocalizer["Select a territory"]</option>
        </select>
    </div>
    <div class="mb-3">
        <label for="usedServiceId" class="form-label">@Localizer["Used service:"]</label>
        <select id="usedServiceId" name="usedServiceId" class="form-select" aria-describedby="service-status" required disabled>
            <option value="">@SharedLocalizer["Select a service"]</option>
        </select>
        <p id="service-status" class="form-text" role="status"></p>
    </div>
    <button type="submit" class="btn btn-primary" disabled>@SharedLocalizer["Save"]</button>
</form>

@if (Model.CanReturnHome)
{
    <form method="post" asp-page-handler="ReturnHome" class="portal-form">
        <input name="hedgehogId" type="hidden" value="@ViewBag.HedgehogId" />
        <input name="communityId" type="hidden" value="@ViewBag.CommunityId" />
        <p>@Localizer["Home territory: {0}", Model.HomeTerritory ?? ""]</p>
        <button type="submit" class="btn btn-outline-primary">@Localizer["Return to the home territory"]</button>
    </form>
}

@section Scripts {
<script>
    const moveForm = document.getElementById('move-territory-form');
    const territory = document.getElementById('newTerritoryId');
    const service = document.getElementById('usedServiceId');
    const serviceStatus = document.getElementById('service-status');
    const save = moveForm.querySelector('button[type="submit"]');
    let lookup;

    async function loadServices() {
        lookup?.abort();
        service.options.length = 1;
        service.value = '';
        service.disabled = true;
        save.disabled = true;
        serviceStatus.textContent = '';
        if (!territory.value) return;

        const request = new AbortController();
        lookup = request;
        serviceStatus.textContent = moveForm.dataset.loading;
        const url = new URL(moveForm.dataset.servicesUrl, window.location.href);
        url.searchParams.set('territoryId', territory.value);
        try {
            const response = await fetch(url, { signal: request.signal });
            if (!response.ok) throw new Error();
            const offers = await response.json();
            if (request.signal.aborted) return;
            for (const offer of offers) service.add(new Option(offer.name, offer.id));
            service.disabled = offers.length === 0;
            if (offers.length === 1) service.value = offers[0].id;
            save.disabled = !service.value;
            serviceStatus.textContent = offers.length ? '' : moveForm.dataset.empty;
        } catch {
            if (!request.signal.aborted) serviceStatus.textContent = moveForm.dataset.error;
        }
    }

    territory.addEventListener('change', loadServices);
    service.addEventListener('change', () => { save.disabled = !service.value; });
    loadServices();
</script>
}
