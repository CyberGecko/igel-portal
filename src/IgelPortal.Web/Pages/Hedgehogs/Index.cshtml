@page "{filter?}"
@model IgelPortal.Web.Pages.Hedgehogs.IndexModel
@{
    bool communityView = ViewBag.IsCommunityView;
    ViewData["Title"] = communityView ? Localizer["Community hedgehogs"] : Localizer["My hedgehogs"];
}

<div class="page-heading">
    <h1>@ViewData["Title"]</h1>
    <a class="btn btn-primary" asp-page="./Create" asp-route-filter="@ViewBag.Filter">
        <i class="bi bi-plus-circle" aria-hidden="true"></i> @SharedLocalizer["Add hedgehog"]
    </a>
</div>
@if (TempData["RecordNotice"] is string notice)
{
    <p class="alert alert-success" role="status">@SharedLocalizer[notice]</p>
}
@if (Model.Hedgehogs.Count == 0)
{
    <p class="portal-empty">@SharedLocalizer["No Hedgehogs registered"]</p>
}
else
{
    <div class="records-grid">
        @foreach (var item in Model.Hedgehogs)
        {
            bool isOwner = item.AttachedUser == User.Identity?.Name;
            <article class="record-card">
                <div class="record-heading">
                    <img src="~/images/hedgehog-avatar.webp" asp-append-version="true" width="56" height="56" loading="lazy" alt="" />
                    <div>
                        <h2><a asp-page="./Details" asp-route-id="@item.Id" asp-route-filter="@ViewBag.Filter">@item.Name</a></h2>
                        <span>@SharedLocalizer[item.BiologicalSex.ToString()]</span>
                    </div>
                </div>
                <dl class="record-fields">
                    <div>
                        <dt>@Html.DisplayNameFor(model => model.Hedgehogs[0].CurrentTerritory)</dt>
                        <dd>@(item.CurrentTerritory ?? SharedLocalizer["No territory"].Value) <partial name="_HedgehogTerritoryServicePartial" model="item" /></dd>
                    </div>
                    <div>
                        <dt>@Html.DisplayNameFor(model => model.Hedgehogs[0].HomeTerritory)</dt>
                        <dd>@(item.HomeTerritory ?? SharedLocalizer["No territory"].Value)</dd>
                    </div>
                    @if (communityView)
                    {
                        <div>
                            <dt>@Html.DisplayNameFor(model => model.Hedgehogs[0].AttachedUserDisplayName)</dt>
                            <dd>@item.AttachedUserDisplayName</dd>
                        </div>
                        <div>
                            <dt>@Html.DisplayNameFor(model => model.Hedgehogs[0].OpenServiceRequests)</dt>
                            <dd>@item.OpenServiceRequests</dd>
                        </div>
                    }
                    else
                    {
                        <div>
                            <dt>@Html.DisplayNameFor(model => model.Hedgehogs[0].Community)</dt>
                            <dd>@(item.Community ?? SharedLocalizer["No community"].Value)</dd>
                        </div>
                    }
                    <div>
                        <dt>@Html.DisplayNameFor(model => model.Hedgehogs[0].ChangeDate)</dt>
                        <dd>@item.ChangeDate.ToShortDateString()</dd>
                    </div>
                </dl>
                @if (isOwner || Model.CanManageCommunity)
                {
                    <div class="portal-actions">
                        @if (isOwner)
                        {
                            <a class="btn btn-outline-primary" asp-page="./Care" asp-route-id="@item.Id">@SharedLocalizer["Care journal"]</a>
                            <a class="btn btn-outline-primary" asp-page="./Edit" asp-route-id="@item.Id" asp-route-filter="@ViewBag.Filter">@SharedLocalizer["Edit"]</a>
                        }
                        <details class="record-actions">
                            <summary>@SharedLocalizer["More actions"]</summary>
                            <ul class="mb-0">
                                @if (Model.CanManageCommunity)
                                {
                                    <li><a asp-page="./ChangeHome" asp-route-id="@item.CommunityId" asp-route-hedgehogId="@item.Id">@Localizer["Change Home Territory"]</a></li>
                                    <li><a asp-page="./MoveTerritory" asp-route-id="@item.CommunityId" asp-route-hedgehogId="@item.Id">@Localizer["Move Territory"]</a></li>
                                    <li><a asp-page="./ChangeAttachedUser" asp-route-id="@item.CommunityId" asp-route-hedgehogId="@item.Id">@Localizer["Change Attached User"]</a></li>
                                    <li><a asp-page="./RequestService" asp-route-id="@item.CommunityId" asp-route-hedgehogId="@item.Id">@Localizer["Request service"]</a></li>
                                }
                                @if (isOwner)
                                {
                                    <li><a asp-page="./Delete" asp-route-id="@item.Id" asp-route-filter="@ViewBag.Filter">@SharedLocalizer["Delete"]</a></li>
                                }
                            </ul>
                        </details>
                    </div>
                }
            </article>
        }
    </div>
}
