@page "{filter?}"
@model IgelPortal.Web.Pages.Hedgehogs.IndexModel

@{
    ViewData["Title"] = $"{Localizer["Hedgehog"].Value} {SharedLocalizer["Index"].Value}";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a class="btn btn-success" asp-page="./Create" asp-route-filter="@ViewBag.Filter"><i class="bi bi-plus-circle"></i><span class="d-none d-md-inline"> @SharedLocalizer["Create New"]</span></a>
</p>
@if (Model.Hedgehogs.Count == 0)
{
    <p>@SharedLocalizer["No Hedgehogs registered"]</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    <label asp-for="Hedgehogs[0].Name"></label>
                </th>
                <th>
                    <label asp-for="Hedgehogs[0].BiologicalSex"></label>
                </th>
                <th>
                    <label asp-for="Hedgehogs[0].HomeTerritory"></label>
                </th>
                <th>
                    <label asp-for="Hedgehogs[0].CurrentTerritory"></label>
                </th>
                @if (!ViewBag.IsCommunityView)
                {
                    <th>
                        <label asp-for="Hedgehogs[0].Community"></label>
                    </th>
                }
                @if (ViewBag.IsCommunityView)
                {
                    <th>
                        <label asp-for="Hedgehogs[0].AttachedUserDisplayName"></label>
                    </th>
                    <th>
                        <label asp-for="Hedgehogs[0].OpenServiceRequests"></label>
                    </th>
                }
                <th>
                    <label asp-for="Hedgehogs[0].ChangeDate"></label>
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Hedgehogs)
            {
                <tr>
                    <td>
                        @item.Name
                    </td>
                    <td>
                        <partial name="_HedgehogGenderPartial" model="@item.BiologicalSex" />
                    </td>
                    <td>
                        @(item.HomeTerritory ?? SharedLocalizer["No territory"].Value)
                    </td>
                    <td>
                        @(item.CurrentTerritory ?? SharedLocalizer["No territory"].Value) <partial name="_HedgehogTerritoryServicePartial" model="@item" />
                    </td>
                    @if (!ViewBag.IsCommunityView)
                    {
                        <td>
                            @(item.Community ?? SharedLocalizer["No community"].Value)
                        </td>
                    }
                    @if (ViewBag.IsCommunityView)
                    {
                        <td>
                            @item.AttachedUserDisplayName
                        </td>
                        <td>
                            @item.OpenServiceRequests
                        </td>
                    }
                    <td>
                        @item.ChangeDate.ToShortDateString()
                    </td>
                    <td>
                        <div class="btn-group" role="group">
                            <a class="btn btn-info" asp-page="./Details" asp-route-id="@item.Id" asp-route-filter="@ViewBag.Filter"><i class="bi bi-search"></i><span class="d-none d-md-inline"> @SharedLocalizer["Details"]</span></a>
                            @if (item.AttachedUser == User?.Identity?.Name)
                            {
                                <a class="btn btn-secondary" asp-page="./Edit" asp-route-id="@item.Id" asp-route-filter="@ViewBag.Filter"><i class="bi bi-pencil"></i><span class="d-none d-md-inline"> @SharedLocalizer["Edit"]</span></a>
                                <a class="btn btn-danger" asp-page="./Delete" asp-route-id="@item.Id" asp-route-filter="@ViewBag.Filter"><i class="bi bi-trash"></i><span class="d-none d-md-inline"> @SharedLocalizer["Delete"]</span></a>
                            }
                            @if (ViewBag.IsCommunityView)
                            {
                                <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-raised-hand"></i><span class="d-none d-md-inline"> @Localizer["Action"] </span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Hedgehogs/ChangeHome" asp-route-id="@item.CommunityId" asp-route-hedgehogId="@item.Id"><i class="bi bi-house-up"></i><span class="d-none d-md-inline"> @Localizer["Change Home Territory"]</span></a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Hedgehogs/MoveTerritory" asp-route-id="@item.CommunityId" asp-route-hedgehogId="@item.Id"><i class="bi bi-arrow-down-up"></i><span class="d-none d-md-inline"> @Localizer["Move Territory"]</span></a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Hedgehogs/ChangeAttachedUser" asp-route-id="@item.CommunityId" asp-route-hedgehogId="@item.Id"><i class="bi bi-person-up"></i><span class="d-none d-md-inline"> @Localizer["Change Attached User"]</span></a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Hedgehogs/RequestService" asp-route-id="@item.CommunityId" asp-route-hedgehogId="@item.Id"><i class="bi bi-envelope-at"></i><span class="d-none d-md-inline"> @Localizer["Request service"]</span></a></li>
                                </ul>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}