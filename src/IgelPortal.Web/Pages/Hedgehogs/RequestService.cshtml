@page "{handler?}"
@model IgelPortal.Web.Pages.Hedgehogs.RequestServiceModel
@{
    ViewData["Title"] = Localizer["Hedgehog"];
}

@if (Model.ResponseToken is Guid token)
{
    <h1>@Localizer["Confirm availability"]</h1>
    <form method="post" asp-page-handler="ServiceResponse">
        <input type="hidden" name="requestToken" value="@token" />
        <button type="submit" class="btn btn-success">@Localizer["Confirm availability"]</button>
    </form>
    return;
}

<h1>@ViewData["Title"]</h1>
@if (TempData["ServiceRequestMailFailures"] is int failures)
{
    <div class="alert alert-warning" role="alert">
        @Localizer["The service request was saved. {0} email notifications could not be submitted.", failures]
    </div>
}

<div class="row">
    <h4>@Localizer["Request service for hedgehog {0}", ViewBag.HedgehogName]</h4>
    <hr />
    <div class="col-md-6">
        <form method="post">
            <input id="communityId" name="communityId" type="hidden" value="@ViewBag.CommunityId" />
            <input id="hedgehogId" name="hedgehogId" type="hidden" value="@ViewBag.HedgehogId" />
            <div class="form-group input-group mb-3">
                <span class="control-label input-group-text">
                    @Localizer["Requested service:"]
                </span>
                <select id="requestServiceId" name="requestServiceId" class="form-control" asp-items="ViewBag.RequestableServices">
                    <option value="" disabled selected>@SharedLocalizer["Select a service"]</option>
                </select>
                <button type="submit" asp-page-handler="RequestService" class="btn btn-success btn-ok">@Localizer["Request"]</button>
            </div>
        </form>
    </div>
</div>
<div class="row">
    <h4>@Localizer["Requested services for hedgehog {0}", ViewBag.HedgehogName]</h4>
    <hr />
    @if (Model.ServiceRequests.Count == 0)
    {
        <p>@SharedLocalizer["No Services requested"]</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th></th>
                    <th>
                        <label asp-for="ServiceRequests[0].CreationDate"></label>
                    </th>
                    <th>
                        <label asp-for="ServiceRequests[0].IsFulfilled"></label>
                    </th>
                    <th>
                        <label asp-for=" ServiceRequests[0].Responses"></label>
                    </th>
                    <th>
                        <label asp-for="ServiceRequests[0].Service"></label>
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ServiceRequests)
                {
                    <tr @(item.Responses.Count > 0 ? $"data-bs-toggle=collapse data-bs-target=#{item.Id} aria-expanded=false aria-controls={item.Id}" : "")>
                        @if (item.Responses.Count > 0)
                        {
                            <td>
                                <i class="bi bi-chevron-down"></i>
                            </td>
                        }
                        <td>
                            @item.CreationDate
                        </td>
                        <td>
                            <i class='bi bi-@(item.IsFulfilled ?"check-lg text-success":"x-lg text-danger")'></i>
                        </td>
                        <td>
                            @item.Responses.Count
                        </td>
                        <td>
                            @item.Service
                        </td>
                        <td>
                            @if (!item.IsFulfilled)
                            {
                                <form method="post" asp-page-handler="MarkAsFulfilled" asp-route-id="@item.Id"><button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i><span class="d-none d-md-inline"> @Localizer["Mark as fulfilled"]</span></button></form>
                            }
                        </td>
                    </tr>
                    @if (item.Responses.Count > 0 && !item.IsFulfilled)
                    {
                        <tr id="@item.Id" class="collapse">
                            <td colspan="5">
                                <div>
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>
                                                    <label asp-for="@item.Responses[0].ResponseDate"></label>
                                                </th>
                                                <th>
                                                    <label asp-for="@item.Responses[0].RespondingUserDisplayName"></label>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var response in item.Responses)
                                            {
                                                <tr>
                                                    <td>
                                                        @response.ResponseDate
                                                    </td>
                                                    <td>
                                                        @response.RespondingUserDisplayName
                                                    </td>
                                                    <td>
                                                        @if (ViewBag.UserTerritories[item.Id].ContainsKey(response.RespondingUserName))
                                                        {
                                                            <div class="dropdown">
                                                                <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                                    <i class="bi bi-gear"></i><span class="d-none d-md-inline"> @Localizer["Initiate Action for territory"]</span>
                                                                </button>
                                                                <ul class="dropdown-menu">
                                                                    @foreach (IgelPortal.Web.Data.Models.Territory territory in ViewBag.UserTerritories[item.Id][response.RespondingUserName])
                                                                    {
                                                                        <li><form method="post" asp-page-handler="InitiateAction" asp-route-id="@item.Id" asp-route-territoryId="@territory.Id"><button type="submit" class="dropdown-item">@territory.Name</button></form></li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>
