@page "{filter?}"
@model IgelPortal.Web.Pages.Territories.EditModel
@{
    ViewData["Title"] = SharedLocalizer["Edit territory"];
}

<div class="page-heading">
    <h1>@ViewData["Title"]</h1>
</div>
<form method="post" asp-route-filter="@ViewBag.Filter" class="portal-form mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <input type="hidden" asp-for="Territory.Id" />
    @Html.EditorFor(model => model.Territory, "TerritoryFields")
    <div class="portal-actions">
        <button class="btn btn-primary" type="submit">@SharedLocalizer["Save"]</button>
        <a class="btn btn-outline-primary" asp-page="./Index" asp-route-filter="@ViewBag.Filter">@SharedLocalizer["Cancel"]</a>
    </div>
</form>

<section class="portal-form">
    <h2 class="h4">@Localizer["Attached Services"]</h2>
    @if (Model.Territory.AttachedServices.Count > 0)
    {
        <ul class="list-group mb-3">
            @foreach (var service in Model.Territory.AttachedServices)
            {
                <li class="list-group-item">
                    <div class="fw-semibold">@service.TerritoryService</div>
                    <div class="mb-2">@Html.DisplayNameFor(model => model.TerritoryAttachedService.MaxCapacity): @service.MaxCapacity</div>
                    <div class="portal-actions">
                        <button type="button" class="btn btn-outline-primary js-edit-territory-service"
                                data-id="@service.Id" data-service="@service.TerritoryServiceId" data-capacity="@service.MaxCapacity">
                            @SharedLocalizer["Edit"]
                        </button>
                        <form method="post" asp-page-handler="RemoveRow" asp-route-filter="@ViewBag.Filter">
                            <input type="hidden" name="id" value="@service.Id" />
                            <input type="hidden" name="territoryId" value="@Model.Territory.Id" />
                            <button type="submit" class="btn btn-outline-danger">@SharedLocalizer["Delete"]</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
    <form id="territory-service-form" method="post" asp-page-handler="AddRow" asp-route-filter="@ViewBag.Filter">
        <input type="hidden" asp-for="TerritoryAttachedService.Id" />
        <input type="hidden" name="territoryId" value="@Model.Territory.Id" />
        <div class="mb-3">
            <label asp-for="TerritoryAttachedService.TerritoryServiceId" class="form-label"></label>
            <select asp-for="TerritoryAttachedService.TerritoryServiceId" asp-items="ViewBag.TerritoryServices" class="form-select" required>
                <option value="">@SharedLocalizer["Select a service"]</option>
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="TerritoryAttachedService.MaxCapacity" class="form-label"></label>
            <input asp-for="TerritoryAttachedService.MaxCapacity" class="form-control" min="0" required />
        </div>
        <div class="portal-actions">
            <button type="submit" class="btn btn-primary" id="save-territory-service"
                    data-create="@SharedLocalizer["Add service"]" data-update="@SharedLocalizer["Save"]">@SharedLocalizer["Add service"]</button>
            <button type="reset" class="btn btn-outline-primary" id="cancel-service-edit" hidden>@SharedLocalizer["Cancel"]</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const serviceForm = document.getElementById('territory-service-form');
        const serviceField = document.getElementById('TerritoryAttachedService_TerritoryServiceId');
        const capacityField = document.getElementById('TerritoryAttachedService_MaxCapacity');
        const idField = document.getElementById('TerritoryAttachedService_Id');
        const saveService = document.getElementById('save-territory-service');
        const cancelEdit = document.getElementById('cancel-service-edit');

        document.querySelectorAll('.js-edit-territory-service').forEach(button => {
            button.addEventListener('click', () => {
                idField.value = button.dataset.id;
                serviceField.value = button.dataset.service;
                capacityField.value = button.dataset.capacity;
                saveService.textContent = saveService.dataset.update;
                cancelEdit.hidden = false;
                serviceField.focus();
            });
        });

        serviceForm.addEventListener('reset', () => {
            idField.value = '';
            saveService.textContent = saveService.dataset.create;
            cancelEdit.hidden = true;
        });
    </script>
}
