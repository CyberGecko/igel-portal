@page
@inject IgelPortal.Web.Interfaces.ICommunityDataService CommunityDataService
@model IgelPortal.Web.Pages.Communities.DetailsModel

@{
    ViewData["Title"] = SharedLocalizer["Details"];
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>@Localizer["Community"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.Name"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.Name
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.Description"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.Description
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.ContactName"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.ContactName
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.ContactMail"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.ContactMail
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.ContactPhone"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.ContactPhone
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.ChangeDate"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.ChangeDate
        </dd>
    </dl>
</div>
<div class="btn-group" role="group">
    <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.Community.Id"><i class="bi bi-pencil"></i><span class="d-none d-md-inline"> @SharedLocalizer["Edit"]</span></a>
    @if ((await CommunityDataService.HasUserCommunityMemberRole(Model.Community.Id, User.Identity, CommunityRoles.OWNER)))
    {
        <a class="btn btn-danger" asp-page="./Delete" asp-route-id="@Model.Community.Id"><i class="bi bi-trash"></i><span class="d-none d-md-inline"> @SharedLocalizer["Delete"]</span></a>
    }
    @if (User.IsInRole(RoleNames.ADMIN))
    {
        <a class="btn btn-info" asp-page="./Index"><i class="bi bi-card-list"></i><span class="d-none d-md-inline"> @SharedLocalizer["Back to List"]</span></a>
    }
    else
    {
        <a class="btn btn-info" asp-page="/Index"><i class="bi bi-card-list"></i><span class="d-none d-md-inline"> @SharedLocalizer["Back to Home"]</span></a>
    }
</div>
