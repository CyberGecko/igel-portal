@page "{id?}/{handler?}/{username?}"
@model IgelPortal.Web.Pages.Communities.MembersModel
@{
    ViewData["Title"] = Localizer["Members"];
}

@if (Model.CommunityMembers.Count == 0)
{
    <p>@Localizer["No Members registered"]</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.CommunityMembers[0].DisplayName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CommunityMembers[0].CommunityRoles)
                </th>@if (ViewBag.IsCommunityOwner)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.CommunityMembers)
            {
                <tr>
                    <td>
                        @item.DisplayName
                    </td>
                    <td>
                        @String.Join(",", item.CommunityRoles.Select(c => SharedLocalizer[c].Value))
                    </td>
                    @if (ViewBag.IsCommunityOwner)
                    {
                        <td>
                            <div class="btn-group" role="group">
                                @if (item.CommunityRoles.Contains(CommunityRoles.APPLICANT))
                                {
                                    <form method="post" class="d-inline" asp-page-handler="Accept" asp-route-id="@item.CommunityId" asp-route-username="@item.UserName"><button type="submit" class="btn btn-success"><i class="bi bi-person-check"></i><span class="d-none d-md-inline"> @Localizer["Accept"]</span></button></form>
                                    <form method="post" class="d-inline" asp-page-handler="Reject" asp-route-id="@item.CommunityId" asp-route-username="@item.UserName"><button type="submit" class="btn btn-danger"><i class="bi bi-person-dash"></i><span class="d-none d-md-inline"> @Localizer["Reject"]</span></button></form>
                                }
                                @if (item.CommunityRoles.Contains(CommunityRoles.MEMBER) && !item.CommunityRoles.Contains(CommunityRoles.OWNER))
                                {
                                    <form method="post" class="d-inline" asp-page-handler="Promote" asp-route-id="@item.CommunityId" asp-route-username="@item.UserName"><button type="submit" class="btn btn-success"><i class="bi bi-person-up-circle"></i><span class="d-none d-md-inline"> @Localizer["Promote"]</span></button></form>
                                }
                                @if (item.CommunityRoles.Contains(CommunityRoles.MODERATOR) && !item.CommunityRoles.Contains(CommunityRoles.OWNER))
                                {
                                    <form method="post" class="d-inline" asp-page-handler="Demote" asp-route-id="@item.CommunityId" asp-route-username="@item.UserName"><button type="submit" class="btn btn-danger"><i class="bi bi-person-down-circle"></i><span class="d-none d-md-inline"> @Localizer["Demote"]</span></button></form>
                                }
                                @if (!item.CommunityRoles.Contains(CommunityRoles.APPLICANT) && !item.CommunityRoles.Contains(CommunityRoles.OWNER))
                                {
                                    <form method="post" id="Remove_@(item.UserName.Replace("@", "").Replace(".", ""))" asp-page-handler="Remove" asp-route-id="@item.CommunityId" asp-route-username="@item.UserName">
                                        <input asp-for="@item.CommunityId" type="hidden" class="form-control" />
                                        <input asp-for="@item.UserName" type="hidden" class="form-control" />
                                        <a class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirm-delete" data-formId="Remove_@(item.UserName.Replace("@", "").Replace(".", ""))"><i class="bi bi-person-x"></i><span class="d-none d-md-inline"> @Localizer["Remove Member"]</span></a>
                                    </form>
                                }
                                @if (!item.CommunityRoles.Contains(CommunityRoles.OWNER) &&
                                     item.CommunityRoles.Any(role => role is CommunityRoles.MEMBER or CommunityRoles.MODERATOR))
                                {
                                    bool hasPermission = item.CommunityRoles.Contains(CommunityRoles.MEDICATION_PLANNER);
                                    <form method="post" class="d-inline" asp-page-handler="MedicationPermission" asp-route-id="@item.CommunityId" asp-route-username="@item.UserName">
                                        <button type="submit" class="btn btn-outline-primary" name="grant" value="@(!hasPermission ? "true" : "false")">
                                            @Localizer[hasPermission ? "Revoke medication planning" : "Grant medication planning"]
                                        </button>
                                    </form>
                                }
                                @if (User.IsInRole(RoleNames.ADMIN) && !item.CommunityRoles.Contains(CommunityRoles.OWNER))
                                {
                                    <form method="post" class="d-inline" asp-page-handler="MakeOwner" asp-route-id="@item.CommunityId" asp-route-username="@item.UserName"><button type="submit" class="btn btn-info"><i class="bi bi-person-badge"></i><span class="d-none d-md-inline"> @Localizer["Make Owner"]</span></button></form>
                                }
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <div class="modal" tabindex="-1" id="confirm-delete" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer["Delete User"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@SharedLocalizer["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p>@SharedLocalizer["Are you sure you want to delete this?"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-bs-dismiss="modal">@SharedLocalizer["Close"]</button>
                    <button type="button" class="btn btn-danger btn-ok">@SharedLocalizer["Delete"]</button>
                </div>
            </div>
        </div>
    </div>


}


@section Scripts {
    <script>
        $('#confirm-delete').on('click', '.btn-ok', function (e) {
            var formId = $(this).data('formid');
            $('#' + formId).submit();
        });

        $('#confirm-delete').on('show.bs.modal', function (e) {
            var formId = e.relatedTarget.dataset.formid;
            $('.btn-ok', this).data('formid', formId);
        });
    </script>
}