@page
@model IgelPortal.Web.Pages.Communities.DeleteModel

@{
    ViewData["Title"] = SharedLocalizer["Delete"];
}

<h1>@ViewData["Title"]</h1>

<h3>@SharedLocalizer["Are you sure you want to delete this?"]</h3>
<div>
    <h4>@Localizer["Community"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.Name"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.Name
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.Description"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.Description
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.ContactName"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.ContactName
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.ContactMail"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.ContactMail
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.ContactPhone"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.ContactPhone
        </dd>
        <dt class="col-sm-2">
            <label asp-for="@Model.Community.ChangeDate"></label>
        </dt>
        <dd class="col-sm-10">
            @Model.Community.ChangeDate
        </dd>
    </dl>

    <form method="post" asp-route-id="@Model.Community.Id">
        <input type="hidden" asp-for="Community.Id" />
        <div class="btn-group" role="group">
            <button class="btn btn-danger" type="submit"><i class="bi bi-trash"></i><span class="d-none d-md-inline"> @SharedLocalizer["Delete"]</span></button>
            @if (User.IsInRole(RoleNames.ADMIN))
            {
                <a class="btn btn-info" asp-page="./Index"><i class="bi bi-card-list"></i><span class="d-none d-md-inline"> @SharedLocalizer["Back to List"]</span></a>
            }
            else
            {
                <a class="btn btn-info" asp-page="/Index"><i class="bi bi-card-list"></i><span class="d-none d-md-inline"> @SharedLocalizer["Back to Home"]</span></a>
            }
        </div>
    </form>
</div>
