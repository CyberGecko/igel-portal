@using Microsoft.AspNetCore.Http.Features

@{
    var consent = Context.Features.Get<ITrackingConsentFeature>();
}

@if (consent?.CanTrack == false)
{
    <aside id="cookieConsent" class="cookie-notice alert alert-dismissible fade show" aria-label="@Localizer["Cookie settings"]">
        <div class="cookie-notice-copy">
            <p class="mb-1">@Localizer["This portal uses cookies and similar technologies."]</p>
            <details>
                <summary>@Localizer["Cookie details"]</summary>
                <p class="mt-2 mb-0">@Localizer["Consent cookie content"] <a asp-area="" asp-page="/Privacy">@Localizer["Learn more"]</a>.</p>
            </details>
        </div>
        <button type="button" class="btn btn-primary" data-bs-dismiss="alert" data-cookie-string="@consent.CreateConsentCookie()">
            @Localizer["Accept"]
        </button>
    </aside>
    <script>
        const acceptCookies = document.querySelector('#cookieConsent [data-cookie-string]');
        acceptCookies.addEventListener('click', () => {
            document.cookie = acceptCookies.dataset.cookieString;
        });
    </script>
}
