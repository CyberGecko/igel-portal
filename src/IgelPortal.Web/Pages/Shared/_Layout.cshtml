@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["Hedgehog Portal"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/29.1.33/fluent.css" />
    <link rel="stylesheet" href="~/lib/flag-icons/css/flag-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IgelPortal.Web.styles.css" asp-append-version="true" />
    <script src="https://cdn.syncfusion.com/ej2/29.1.33/ej2-base/dist/global/ej2-base.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/29.1.33/ej2-data/dist/global/ej2-data.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/29.1.33/ej2-svg-base/dist/global/ej2-svg-base.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/29.1.33/ej2-pdf-export/dist/global/ej2-pdf-export.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/29.1.33/ej2-compression/dist/global/ej2-compression.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/29.1.33/ej2-file-utils/dist/global/ej2-file-utils.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/29.1.33/ej2-maps/dist/global/ej2-maps.min.js"></script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/favicon-32x32.png" alt="@Localizer["Hedgehog Portal"]" width="30" height="24" class="d-inline-block align-text-top">
                    <span class="d-none d-md-inline">@Localizer["Hedgehog Portal"]</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-md-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">@Localizer["Home"]</a>
                        </li>
                        @if (User.IsInRole(RoleNames.USER))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Hedgehogs/Index" asp-route-filter="my">@Localizer["My Hedgehogs"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Territories/Index" asp-route-filter="my">@Localizer["My Territories"]</a>
                            </li>
                            <vc:community-administration-menu />
                        }
                        @if (User.IsInRole(RoleNames.ADMIN))
                        {
                            <li class="nav-item dropdown d-none d-md-inline">
                                <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">@Localizer["Administration"]</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Communities/Index">@Localizer["Communities"]</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Administration/TerritoryServices">@Localizer["Territory Services"]</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Administration/Users">@Localizer["User"]</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Administration/Roles">@Localizer["Roles"]</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown d-md-none">
                                <a class="nav-link text-dark dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">@Localizer["Administration"]</a>
                                <ul class="dropdown-menu border-0">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Communities/Index">@Localizer["Communities"]</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Administration/TerritoryServices">@Localizer["Territory Services"]</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Administration/Users">@Localizer["User"]</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Administration/Roles">@Localizer["Roles"]</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                    <vc:culture-switcher show-current-culture=false />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <partial name="_CookieConsentPartial" />
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - @Localizer["Hedgehog Portal"] - <a asp-area="" asp-page="/Privacy">@Localizer["Privacy"]</a> - <a asp-area="" asp-page="/LegalNotice">@Localizer["Legal Notice"]</a>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <ejs-scripts></ejs-scripts>
</body>
</html>