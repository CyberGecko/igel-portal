@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using System.Globalization
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["Hedgehog Portal"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/flag-icons/css/flag-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IgelPortal.Web.styles.css" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" asp-append-version="true">
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" asp-append-version="true">
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="visually-hidden-focusable skip-link" href="#main-content">@Localizer["Skip to content"]</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="~/images/hedgehog-avatar.webp" asp-append-version="true" alt="" width="40" height="40">
                    <span>@Localizer["Hedgehog Portal"]</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#portal-navigation" aria-controls="portal-navigation"
                        aria-expanded="false" aria-label="@Localizer["Toggle navigation"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="portal-navigation" class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">@Localizer["Home"]</a>
                        </li>
                        @if (User.IsInRole(RoleNames.USER))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Hedgehogs/Index" asp-route-filter="my">@Localizer["My Hedgehogs"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Territories/Index" asp-route-filter="my">@Localizer["My Territories"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Communities/Join">@Localizer["Communities"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Hedgehogs/CareTasks">@SharedLocalizer["My tasks"]</a>
                            </li>
                        }
                        @if (User.IsInRole(RoleNames.ADMIN))
                        {
                            <li class="nav-item dropdown">
                                <button type="button" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">@Localizer["Administration"]</button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Communities/Index">@Localizer["Communities"]</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Administration/TerritoryServices">@Localizer["Territory Services"]</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Administration/Users">@Localizer["User"]</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Administration/Roles">@Localizer["Roles"]</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                    <vc:culture-switcher />
                </div>
            </div>
        </nav>
    </header>
    <div class="container portal-content">
        <partial name="_CookieConsentPartial" />
        <main id="main-content" tabindex="-1" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - @Localizer["Hedgehog Portal"] - <a asp-area="" asp-page="/Privacy">@Localizer["Privacy"]</a> - <a asp-area="" asp-page="/LegalNotice">@Localizer["Legal Notice"]</a>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
