@model IEnumerable<IgelPortal.Web.Data.Models.Hedgehog>

<div class="dashboard-panel">
    <h2>@Localizer["My Hedgehogs"]</h2>
    @if (Model.Any())
    {
        <ul class="dashboard-list">
            @foreach (var hedgehog in Model.Take(4))
            {
                <li>
                    <img src="~/images/hedgehog-avatar.webp" asp-append-version="true" width="56" height="56" alt="" />
                    <div>
                        <a class="fw-semibold" asp-page="/Hedgehogs/Details" asp-route-id="@hedgehog.Id" asp-route-filter="my">@hedgehog.Name</a>
                        <p>@(hedgehog.CurrentTerritory ?? SharedLocalizer["No territory"].Value)</p>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <p>@SharedLocalizer["No Hedgehogs registered"]</p>
    }
    <div class="portal-actions mt-auto">
        <a class="btn btn-primary" asp-page="/Hedgehogs/Create" asp-route-filter="my">@SharedLocalizer["Add hedgehog"]</a>
        @if (Model.Any())
        {
            <a class="btn btn-outline-primary" asp-page="/Hedgehogs/Index" asp-route-filter="my">@SharedLocalizer["View all"]</a>
        }
    </div>
</div>
