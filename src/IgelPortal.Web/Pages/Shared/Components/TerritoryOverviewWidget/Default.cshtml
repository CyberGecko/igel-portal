@model IEnumerable<IgelPortal.Web.Data.Models.Territory>

<div class="dashboard-panel">
    <h2>@Localizer["My Territories"]</h2>
    @if (Model.Any())
    {
        <ul class="dashboard-list">
            @foreach (var territory in Model.Take(4))
            {
                <li>
                    <div class="dashboard-symbol"><i class="bi bi-geo-alt" aria-hidden="true"></i></div>
                    <div>
                        <a class="fw-semibold" asp-page="/Territories/Details" asp-route-id="@territory.Id" asp-route-filter="my">@territory.Name</a>
                        <p>@territory.Street @territory.StreetNumber, @territory.PostalCode @territory.City</p>
                    </div>
                </li>
            }
        </ul>
    }
    else
    {
        <p>@SharedLocalizer["No Territories registered"]</p>
    }
    <div class="portal-actions mt-auto">
        <a class="btn btn-primary" asp-page="/Territories/Create" asp-route-filter="my">@SharedLocalizer["Add territory"]</a>
        @if (Model.Any())
        {
            <a class="btn btn-outline-primary" asp-page="/Territories/Index" asp-route-filter="my">@SharedLocalizer["View all"]</a>
        }
    </div>
</div>
