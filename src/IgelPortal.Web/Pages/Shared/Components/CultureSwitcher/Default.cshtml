@model IgelPortal.Web.Models.CultureSwitcherModel

<form asp-page="/Index" asp-page-handler="SetLanguage" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <div class="dropdown">
        <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                aria-label="@SharedLocalizer["Change language"]">
            <span class="fi fi-@(new System.Globalization.RegionInfo(Model.CurrentUICulture.Name).TwoLetterISORegionName.ToLowerInvariant())" aria-hidden="true"></span>
            @Model.CurrentUICulture.TwoLetterISOLanguageName.ToUpperInvariant()
        </button>
        <ul class="dropdown-menu dropdown-menu-lg-end">
            @foreach (var culture in Model.SupportedCultures)
            {
                <li>
                    <button class="dropdown-item" type="submit" name="culture" value="@culture.Name" lang="@culture.Name">
                        @culture.NativeName
                    </button>
                </li>
            }
        </ul>
    </div>
</form>
