@page
@using Microsoft.AspNetCore.Authentication
@model LoginModel

@{
    ViewData["Title"] = Localizer["Log in"];
}

<h1>@ViewData["Title"]</h1>
@if (Model.ConfirmAccount)
{
    <p class="alert alert-info">@Localizer["Sign in again to confirm changes to your account security."]</p>
}
<div class="row g-4">
    <div class="col-md-6">
        <form method="post" asp-page-handler="Passkey" asp-route-returnUrl="@Model.ReturnUrl" asp-route-confirmAccount="@Model.ConfirmAccount"
              data-passkey-form="get" data-options-url="@Url.Page("./Login", "PasskeyOptions")"
              data-error="@Localizer["Could not sign in with a passkey. Try again or use another sign-in method."]" hidden>
            <input type="hidden" name="credential" />
            <button id="passkey-sign-in" type="submit" class="w-100 btn btn-lg btn-primary">
                <i class="bi bi-fingerprint" aria-hidden="true"></i> @Localizer["Sign in with a passkey"]
            </button>
            <p class="mt-2 mb-0 text-body-secondary">@Localizer["Use your device PIN, fingerprint, face recognition or a security key."]</p>
            <div class="alert alert-danger mt-2" role="alert" data-passkey-error hidden></div>
        </form>
        @if (Model.PasskeyError is { } passkeyError)
        {
            <p class="alert alert-danger mt-2" role="alert">@passkeyError</p>
        }
        <p data-passkey-unavailable hidden>@Localizer["This browser does not support passkeys."]</p>
    </div>
</div>
<div class="row g-4 mt-2">
    <div class="col-md-6">
        <section>
            <form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl" asp-route-confirmAccount="@Model.ConfirmAccount">
                <h2>@Localizer["Sign in with a password"]</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">@Localizer["Email"]</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@Localizer["Password"]" />
                    <label asp-for="Input.Password" class="form-label">@Localizer["Password"]</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">@Localizer["Log in"]</button>
                </div>
                <div>
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">@Localizer["Forgot your password?"]</a>
                    </p>
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Register as a new user"]</a>
                    </p>
                    <p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">@Localizer["Resend email confirmation"]</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="col-md-6">
            <section>
                <h3>@Localizer["Use another service to log in."]</h3>
                <hr />
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" asp-route-confirmAccount="@Model.ConfirmAccount" method="post" class="form-horizontal">
                    <div>
                        <p>
                            @foreach (AuthenticationScheme provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="@Localizer["Log in using your {0} account", provider.DisplayName??"N.A."]">@(provider.DisplayName ?? "N.A.")</button>
                            }
                        </p>
                    </div>
                </form>
            </section>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/passkeys.js" asp-append-version="true" defer></script>
}
