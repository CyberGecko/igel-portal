@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = Localizer["Configure authenticator app"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div>
    <p>@Localizer["To use an authenticator app go through the following steps:"]</p>
    <ol class="list">
        <li>
            <p>
                @Localizer["Download a two-factor authenticator app like Microsoft Authenticator for"]
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> @Localizer["and"]
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a>,
                @Localizer["Google Authenticator for"]
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=de">Android</a> @Localizer["and"]
                <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a> @Localizer["or"]
                @Localizer["Twilio Authy Authenticator for"]
                <a href="https://play.google.com/store/apps/details?id=com.authy.authy&hl=de">Android</a> @Localizer["and"]
                <a href="https://apps.apple.com/de/app/twilio-authy/id494168017?mt=8">iOS</a>.
            </p>
        </li>
        <li>
            <p>@Localizer["Scan the QR Code or enter this key <kbd>{0}</kbd> into your two factor authenticator app. Spaces and casing do not matter.", Model.SharedKey]</p>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                @Localizer["Once you have scanned the QR code or input the key above, your two factor authentication app will provide you</br>with a unique code. Enter the code in the confirmation box below."]
            </p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="@Localizer["Please enter the code."]" />
                            <label asp-for="Input.Code" class="control-label form-label">@Localizer["Verification Code"]</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">@Localizer["Verify"]</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script type="text/javascript" src="~/lib/qrcode.js"></script>
    <script type="text/javascript" src="~/js/qr.js"></script>
}
