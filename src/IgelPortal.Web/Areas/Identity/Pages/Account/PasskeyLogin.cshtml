@page
@model PasskeyLoginModel

@{
    ViewData["Title"] = Localizer["Log in"];
}

<h1>@ViewData["Title"]</h1>

<div class="row mb-2">
    <ul class="nav nav-tabs">
        <li class="nav-item">
            <a class="nav-link" href="./Login"><i class="bi bi-key"></i><span class="d-none d-md-inline"> @Localizer["With Password"]</span></a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" aria-current="@Localizer["Passkey"]" href="#"><i class="bi bi-fingerprint"></i><span class="d-none d-md-inline"> @Localizer["Passkey"]</span></a>
        </li>
    </ul>
</div>
<div class="row">
    <div class="col-md-4">
        <section>
            <form id="loginForm" method="post">
                <h2>@Localizer["Use a local account to log in."]</h2>
                <hr />
                <div class="form-floating mb-3">
                    <input id="loginUserName" name="userName" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label for="loginUserName" class="form-label">@Localizer["Email"]</label>
                    <span validation-for="loginUserName" class="text-danger"></span>
                </div>
                <div>
                    <input id="loginReturnUrl" name="returnUrl" type="hidden" value="@Model.ReturnUrl" />
                    <button id="loginsubmit" type="submit" class="w-100 btn btn-lg btn-primary">@Localizer["Log in"]</button>
                </div>
                <div>
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Register as a new user"]</a>
                    </p>
                    <p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">@Localizer["Resend email confirmation"]</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="col-md-6 col-md-offset-2">
            <section>
                <h3>@Localizer["Use another service to log in."]</h3>
                <hr />
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                    <div>
                        <p>
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="@Localizer["Log in using your {0} account", provider?.DisplayName??"N.A."]">@(provider?.DisplayName ?? "N.A.")</button>
                            }
                        </p>
                    </div>
                </form>
            </section>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/helpers.js" asp-append-version="true"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
}
